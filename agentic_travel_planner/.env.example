# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
GROQ_API_KEY=
RAPIDAPI_KEY=
GEOAPIFY_KEY=
GEMINI_API_KEY=

# Redis for background-job status. Local docker-compose sets this to the compose service.
REDIS_URL=redis://localhost:6379/0

# CORS allowlist for the deployed frontend origin(s), comma-separated.
# Leave unset for local dev (defaults to "*").
ALLOWED_ORIGINS=

# Optional: LLM_PROVIDER=openai (then also set OPENAI_API_KEY), WORKER_MODEL, REASONING_MODEL
